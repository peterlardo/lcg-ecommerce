generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum DeliveryMode {
  DELIVERY
  PICKUP
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  phone         String?
  image         String?
  role          String    @default("CUSTOMER")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  addresses            Address[]
  orders               Order[]
  reservations         Reservation[]
  deliveryAgentProfile DeliveryAgent?
  managedPointOfSales  PointOfSale[]        @relation("PointOfSaleManager")
  permissions          UserPermission[]
  producedLots         ProductionLot[]
  stockMovements       StockMovement[]
  openedCashSessions   CashSession[]
  passwordResetTokens  PasswordResetToken[]
  sentMessages         ChatMessage[]        @relation("ChatSender")
  receivedMessages     ChatMessage[]        @relation("ChatReceiver")
  chatPresence         ChatPresence?
  clients              Client[]
  announcements        Announcement[]
  deviceSessions       UserDeviceSession[]
  loginLogs            LoginLog[]
  activityLogs         ActivityLog[]

  operationZone String?
  zoneLat       Float?
  zoneLng       Float?
  zoneRadiusKm  Float?  @default(10)
}

model RoleProfile {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  color       String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserPermission {
  id        String  @id @default(cuid())
  userId    String
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model RolePermission {
  id        String  @id @default(cuid())
  role      String
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([role, module])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  street    String
  city      String
  district  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())

  products   Product[]
  promotions Promotion[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  subtitle    String?
  description String?
  image       String?
  badge       String?
  categoryId  String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  orderItems OrderItem[]
  promotions Promotion[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  format    String
  price     Float
  stock     Int     @default(0)
  unit      String?

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  pointOfSaleStocks PointOfSaleStock[]
  productionLots    ProductionLot[]
}

enum CouponType {
  PERCENT
  FIXED
}

model Promotion {
  id         String   @id @default(cuid())
  name       String
  percent    Float
  productId  String?
  categoryId String?
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([isActive, startsAt, endsAt])
  @@index([productId])
  @@index([categoryId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType @default(PERCENT)
  value       Float
  minSubtotal Float      @default(0)
  startsAt    DateTime   @default(now())
  endsAt      DateTime?
  maxUses     Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String?
  b2bClientId     String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  addressId       String?
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus  @default(PENDING)
  subtotal        Float          @default(0)
  deliveryFee     Float          @default(0)
  discountAmount  Float          @default(0)
  couponCode      String?
  total           Float          @default(0)
  notes           String?
  pointOfSaleId   String?
  source          String         @default("WEB")
  ticketGenerated Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  b2bClient    B2BClient?    @relation(fields: [b2bClientId], references: [id], onDelete: SetNull)
  address      Address?      @relation(fields: [addressId], references: [id])
  items        OrderItem[]
  delivery     Delivery?
  reservations Reservation[]
  pointOfSale  PointOfSale?  @relation(fields: [pointOfSaleId], references: [id], onDelete: SetNull)

  @@index([pointOfSaleId, status])
  @@index([pointOfSaleId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([b2bClientId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String
  quantity  Int
  price     Float
  total     Float
  lotId     String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  lot     ProductionLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
}

model Delivery {
  id            String         @id @default(cuid())
  orderId       String         @unique
  mode          DeliveryMode   @default(DELIVERY)
  agentId       String?
  zoneId        String?
  fee           Float          @default(0)
  status        DeliveryStatus @default(PENDING)
  address       String
  city          String
  district      String?
  scheduledDate DateTime?
  assignedAt    DateTime?
  // Le livreur a vu et accepté la livraison (remis à zéro à chaque réattribution).
  acceptedAt    DateTime?
  deliveredAt   DateTime?
  failedReason  String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent  DeliveryAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  zone   DeliveryZone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([agentId, status])
  @@index([scheduledDate])
  @@index([deliveredAt])
  @@index([mode])
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String   @unique
  baseFee   Float    @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentFees    DeliveryAgentFee[]
  deliveries   Delivery[]
  reservations Reservation[]
}

model DeliveryAgent {
  id          String   @id @default(cuid())
  name        String
  kind        String   @default("MAISON")
  userId      String?  @unique
  companyName String?
  phone       String?
  vehicle     String?
  plateNumber String?
  zonesLabel  String?
  isAvailable Boolean  @default(true)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  fees       DeliveryAgentFee[]
  deliveries Delivery[]

  @@index([kind, isActive])
}

model DeliveryAgentFee {
  id      String  @id @default(cuid())
  agentId String
  zoneId  String
  fee     Float   @default(0)

  agent DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  zone  DeliveryZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([agentId, zoneId])
}

model StockMovement {
  id                String   @id @default(cuid())
  variantId         String
  type              String
  quantity          Int
  reason            String?
  reference         String?
  pointOfSaleId     String?
  lotId             String?
  userId            String?
  createdAt         DateTime @default(now())

  variant          ProductVariant   @relation(fields: [variantId], references: [id])
  pointOfSale      PointOfSale?     @relation(fields: [pointOfSaleId], references: [id], onDelete: SetNull)
  lot              ProductionLot?   @relation(fields: [lotId], references: [id], onDelete: SetNull)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pointOfSaleId, createdAt])
  @@index([variantId])
  @@index([userId, createdAt])
  @@index([type])
}

model ProductionLot {
  id                String    @id @default(cuid())
  lotNumber         String    @unique
  variantId         String
  initialQuantity   Int
  remainingQuantity Int
  productionDate    DateTime  @default(now())
  expiryDate        DateTime?
  status            String    @default("ACTIVE")
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  variant           ProductVariant   @relation(fields: [variantId], references: [id])
  createdBy         User?            @relation(fields: [createdById], references: [id])
  stockMovements    StockMovement[]
  allocations       LotAllocation[]
  orderItems        OrderItem[]
}

model LotAllocation {
  id        String   @id @default(cuid())
  lotId     String
  quantity  Int
  type      String
  reference String?
  createdAt DateTime @default(now())

  lot ProductionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  nom       String
  telephone String
  email     String   @default("")
  objet     String   @default("Question générale")
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Reservation {
  id            String            @id @default(cuid())
  userId        String?
  orderId       String?
  client        String
  telephone     String
  email         String            @default("")
  type          String
  date          String
  heure         String
  inviteCount   Int               @default(0)
  address       String            @default("")
  itemsJson     String            @default("[]")
  notes         String            @default("")
  status        ReservationStatus @default(PENDING)
  pointOfSaleId String?
  source        String            @default("WEB")
  // Livraison à date : retrait sur place ou livraison dans une zone (frais calculés), sur un créneau fixe.
  deliveryMode  String            @default("DELIVERY")
  zoneId        String?
  deliveryFee   Float             @default(0)
  slot          String            @default("")
  createdAt     DateTime          @default(now())
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pointOfSale   PointOfSale?      @relation(fields: [pointOfSaleId], references: [id], onDelete: SetNull)
  zone          DeliveryZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
}

model B2BClient {
  id         String   @id @default(cuid())
  externalId Int      @unique
  name       String
  category   String
  phone      String
  status     String   @default("Validé")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  address       String?
  city          String?
  latitude      Float?
  longitude     Float?
  geoSource     String?
  geoConfidence String?
  geoVerified   Boolean @default(false)

  orders Order[]

  @@index([latitude, longitude])
  @@index([geoVerified])
}

enum ClientType {
  B2B
  B2C
}

model Client {
  id           String     @id @default(cuid())
  type         ClientType @default(B2C)
  // B2B
  companyName  String?
  tradeName    String?
  contactName  String?
  taxId        String?
  // B2C
  firstName    String?
  lastName     String?
  // Commun
  email        String?
  phone        String?
  city         String?
  address      String?
  latitude     Float?
  longitude    Float?
  notes        String?
  isActive     Boolean    @default(true)
  commercialId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  commercial User? @relation(fields: [commercialId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([commercialId])
  @@index([isActive])
}

model PointOfSale {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  type          String   @default("COMPTOIR") // COMPTOIR | VEHICLE
  address       String
  city          String
  phone         String?
  managerName   String?
  managerUserId String?
  plateNumber   String? // Immatriculation (véhicules uniquement)
  capacity      Int? // Capacité max en unités (null = illimité)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders         Order[]
  managerUser    User?              @relation("PointOfSaleManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  stocks         PointOfSaleStock[]
  cashSessions   CashSession[]
  stockMovements StockMovement[]
  reservations   Reservation[]

  @@index([type])
  @@index([type, isActive])
}

model PointOfSaleStock {
  id            String   @id @default(cuid())
  pointOfSaleId String
  variantId     String
  quantity      Int      @default(0)
  updatedAt     DateTime @updatedAt

  pointOfSale PointOfSale    @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([pointOfSaleId, variantId])
}

// NOTE : le modele SellerDailyStock (affectation de stock a un vendeur) a ete
// supprime. Le stock appartient au seul point de vente : le vendeur puise dans
// le pool du PDV, sans stock reserve ni retour de stock a la cloture.

model CashSession {
  id             String    @id @default(cuid())
  pointOfSaleId  String
  openedById     String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingBalance Float     @default(0)
  closingBalance Float?
  status         String    @default("OPEN")
  reportGeneratedAt DateTime?
  reportReference   String?

  pointOfSale PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  openedBy    User?       @relation(fields: [openedById], references: [id], onDelete: SetNull)

  @@index([pointOfSaleId, status])
  @@index([pointOfSaleId, openedAt])
  @@index([openedById, status])
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  fileUrl  String?
  fileName String?
  fileType String?
  fileSize Int?

  sender   User @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

model ChatPresence {
  id       String   @id @default(cuid())
  userId   String   @unique
  lastSeen DateTime @default(now())
  isTyping Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id            String    @id @default(cuid())
  message       String
  tone          String    @default("danger") // danger = red, warning = amber, info = blue
  audience      String    @default("ALL") // ALL | ROLES | USERS
  targetRoles   String[]  @default([])
  targetUserIds String[]  @default([])
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

// Sessions par appareil d'un utilisateur : une ligne = un appareil/navigateur.
// sessionId est injecté dans le JWT signé par Auth.js pour relier chaque requête
// authentifiée à l'appareil correspondant (vu que le provider Credentials ne
// remplit jamais la table Session de l'adaptateur).
model UserDeviceSession {
  id           String    @id @default(cuid())
  userId       String
  sessionId    String    @unique
  fingerprint  String
  deviceName   String?
  deviceType   String? // mobile | tablet | desktop
  ip           String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([lastActiveAt])
}

// Journal des connexions (réussies, échouées, déconnexions)
model LoginLog {
  id         String   @id @default(cuid())
  userId     String?
  email      String? // email saisi pour les tentatives échouées sans compte identifié
  status     String   @default("SUCCESS") // SUCCESS | FAILED | LOGOUT
  method     String   @default("PASSWORD")
  deviceName String?
  deviceType String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// Journal des actions métier des utilisateurs staff
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  module    String
  action    String
  entity    String?
  entityId  String?
  summary   String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([module, createdAt])
  @@index([createdAt])
}
